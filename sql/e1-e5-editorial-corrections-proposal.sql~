-- Serialize editorial writes during this short batch, including concurrent tag changes.
LOCK TABLE public.events, public.tags, public.event_tags IN SHARE ROW EXCLUSIVE MODE;

DO $preflight$
DECLARE
    p record;
    actual jsonb;
    actual_tags jsonb;
BEGIN
    IF (SELECT count(*) FROM bc_e1_e5_proposal) <> 5 THEN
        RAISE EXCEPTION 'E1-E5: expected exactly five reviewed records';
    END IF;
    IF NOT EXISTS (
        SELECT 1 FROM public.tags
        WHERE id = 'b2f9c183-e79c-4c1f-8b9b-dfb3ae408da0'::uuid
          AND name = 'Czech Republic'
    ) THEN
        RAISE EXCEPTION 'E2: the reviewed Czech Republic tag is absent or renamed';
    END IF;
    FOR p IN SELECT * FROM bc_e1_e5_proposal ORDER BY finding LOOP
        SELECT to_jsonb(e) INTO actual FROM public.events e WHERE e.id = p.event_id;
        IF actual IS NULL THEN
            RAISE EXCEPTION '%: reviewed event % is missing', p.finding, p.event_id;
        END IF;
        SELECT coalesce(jsonb_agg(jsonb_build_object('id', t.id, 'name', t.name)
                                 ORDER BY t.id), '[]'::jsonb)
        INTO actual_tags
        FROM public.event_tags et JOIN public.tags t ON t.id = et.tag_id
        WHERE et.event_id = p.event_id;
        IF NOT ((actual @> p.expected AND actual_tags = p.before_tags)
                OR (actual @> p.proposed AND actual_tags = p.after_tags)) THEN
            RAISE EXCEPTION '%: content/date/category/publication state or tags changed for %. No changes applied; review a fresh baseline.',
                            p.finding, p.event_id;
        END IF;
    END LOOP;
END;
$preflight$;

UPDATE public.events AS e
SET title = p.proposed->>'title',
    description = p.proposed->>'description',
    sources = p.proposed->>'sources'
FROM bc_e1_e5_proposal AS p
WHERE e.id = p.event_id
  AND (e.title, e.description, e.sources) IS DISTINCT FROM
      (p.proposed->>'title', p.proposed->>'description', p.proposed->>'sources');

-- E2: add the already-existing geographical tag; retain all reviewed current links.
INSERT INTO public.event_tags (event_id, tag_id)
VALUES ('3df5535f-0f59-463a-8e3e-ff80ec998e3a'::uuid,
        'b2f9c183-e79c-4c1f-8b9b-dfb3ae408da0'::uuid)
ON CONFLICT (event_id, tag_id) DO NOTHING;

DO $postflight$
DECLARE
    p record;
    actual jsonb;
    actual_tags jsonb;
BEGIN
    FOR p IN SELECT * FROM bc_e1_e5_proposal ORDER BY finding LOOP
        SELECT to_jsonb(e) INTO actual FROM public.events e WHERE e.id = p.event_id;
        SELECT coalesce(jsonb_agg(jsonb_build_object('id', t.id, 'name', t.name)
                                 ORDER BY t.id), '[]'::jsonb)
        INTO actual_tags
        FROM public.event_tags et JOIN public.tags t ON t.id = et.tag_id
        WHERE et.event_id = p.event_id;
        IF actual IS NULL OR NOT (actual @> p.proposed) OR actual_tags <> p.after_tags THEN
            RAISE EXCEPTION '%: post-update verification failed; rolling back the batch', p.finding;
        END IF;
    END LOOP;
END;
$postflight$;

COMMIT;

-- Read-only verification after successful execution. Expect five rows; all preserved
-- dates/categories below, and Czech Republic among E2's five tags.
