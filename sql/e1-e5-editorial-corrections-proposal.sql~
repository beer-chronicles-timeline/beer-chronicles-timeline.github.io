LEFT JOIN public.tags t ON t.id = et.tag_id
WHERE e.id IN (
    '0a5a3946-30db-4a61-8d4d-bc36cbda6a7b'::uuid,
    '3df5535f-0f59-463a-8e3e-ff80ec998e3a'::uuid,
